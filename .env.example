# Optional: enables the "Sync with Google Drive" option.
# Create a Web OAuth Client ID in Google Cloud Console (Drive API enabled),
# add your origins (https://barelytrack.vercel.app and http://localhost:5173),
# then paste the client id here (and set it in the Vercel project env).
# Left unset, the Google Drive option is simply hidden.
VITE_GOOGLE_CLIENT_ID=296481444111-7oid7daud02rhebcij7iqkuel0pi7shp.apps.googleusercontent.com

# Passphrase sync backend (server-only; set in the Vercel project env, NOT the
# client). Create a free Upstash Redis DB and paste its REST credentials.
# The /api/sync Edge Function uses these; the client never sees them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
